# توکن را از @BotFather بگیرید.
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_real_token

# برای امنیت، فقط Telegram IDهای این فهرست اجازه‌ی هش‌کردن دارند.
# چند شناسه را با ویرگول جدا کنید: 123456789,987654321
# اگر خالی باشد، فقط دستور /id کار می‌کند و ربات چیزی را هش نمی‌کند.
ALLOWED_USER_IDS=

# حذف خودکار پیام‌های حاوی ورودی (پیشنهاد: روشن بماند)
DELETE_INPUT_MESSAGES=true

# حداکثر طول ورودی؛ سقف پیام متنی تلگرام 4096 است.
MAX_INPUT_LENGTH=4096
